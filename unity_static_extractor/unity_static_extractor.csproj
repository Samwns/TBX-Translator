<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- UABEA ships its tested AssetsTools.NET binaries.  Referencing them
       directly keeps the scanner aligned with the UABEA reader/writer instead
       of an independently resolved NuGet version. -->
  <ItemGroup>
    <Reference Include="AssetsTools.NET">
      <HintPath>../third_party/UABEA/Libs/AssetsTools.NET.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="AssetsTools.NET.MonoCecil">
      <HintPath>../third_party/UABEA/Libs/AssetsTools.NET.MonoCecil.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- UABEA references Mono.Cecil from NuGet rather than shipping it in Libs. -->
    <PackageReference Include="Mono.Cecil" Version="0.11.4" />
  </ItemGroup>

  <ItemGroup>
    <None Update="classdata.tpk">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
